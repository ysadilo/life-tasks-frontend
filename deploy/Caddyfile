# Plain HTTP on :80 — the Cloudflare Tunnel connector reaches this at
# http://frontend:80 and Cloudflare terminates TLS for lifetasks.today at the edge.
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	root * /srv

	# Hashed build assets: immutable, and 404 (never index.html) when missing —
	# a stale client must get a hard error it can recover from, not HTML.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Never let a CDN/browser pin the entry points, or a deploy goes unseen and
	# the service worker can't self-update.
	@entry path /index.html /sw.js /manifest.webmanifest /registerSW.js
	header @entry Cache-Control "no-cache"

	handle {
		try_files {path} /index.html
		file_server
	}
}
