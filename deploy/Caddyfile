# Plain HTTP on :80 — the Cloudflare Tunnel connector reaches this at
# http://frontend:80 and Cloudflare terminates TLS for lifetasks.today at the edge.
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	root * /srv

	# Hashed build assets: serve if present, 404 if not — never fall back to
	# index.html, or a stale client gets HTML in place of a missing .js/.css.
	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
